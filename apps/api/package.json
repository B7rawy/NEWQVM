{
  "name": "@qvm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QVM Platform backend — NestJS + Drizzle, RLS-scoped per request.",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "tsx scripts/verify-rls.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx drizzle/seed/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@qvm/shared": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
