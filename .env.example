# ─── Database (self-hosted Postgres) ───────────────────────────────
POSTGRES_USER=qvm
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=qvm_platform
POSTGRES_PORT=5434
DATABASE_URL=postgresql://qvm:change_me_in_local_env@localhost:5434/qvm_platform
# Runtime API connects as the NON-superuser app role (subject to RLS). Migrations/seed use DATABASE_URL (owner).
APP_DATABASE_URL=postgresql://qvm_app:qvm_app_local_dev@localhost:5434/qvm_platform

# ─── API ───────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
# JWT signing (generate a strong secret per environment)
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_EXPIRES_IN=1d

# ─── Multi-tenancy ─────────────────────────────────────────────────
# root domain for subdomain routing, e.g. company-a.<APP_ROOT_DOMAIN>
APP_ROOT_DOMAIN=qvm.localhost

# ─── File storage (MinIO / S3-compatible) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_in_local_env
S3_BUCKET=qvm-attachments

# ─── Side-effect providers (disabled/sandboxed in non-prod) ────────
# Sandbox tenants NEVER hit real providers — the notifications layer guards on is_sandbox.
EMAIL_PROVIDER=console        # console | smtp | resend
WHATSAPP_ENABLED=false
PAYMENT_MODE=sandbox          # sandbox | live

# ─── Web (Vite) ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─── AI assistant (workflow builder chat) ──────────────────────────
# Drafts a flow on the canvas from a plain-Arabic description. The model PROPOSES; the server
# validates the result against the real status catalog before it renders; a human saves it.
# NEVER commit a real key — .gitignore keeps .env out of git, and this file holds placeholders only.
AI_PROVIDER=gemini            # gemini | claude | off
GEMINI_API_KEY=               # set on the server only:  ssh <host> "printf '\nGEMINI_API_KEY=…\n' >> .env"
GEMINI_MODEL=gemini-2.0-flash
