{
  "name": "qvm-platform",
  "version": "0.0.0",
  "private": true,
  "description": "QVM Platform — clean multi-tenant rebuild of the Qparts/QVM procurement system",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @qvm/api db:migrate",
    "db:seed": "pnpm --filter @qvm/api db:seed"
  }
}
